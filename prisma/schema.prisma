generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model markets {
  id                 Int      @id @default(autoincrement())
  slug               String   @unique(map: "markets_slug_unique")
  title              String
  categories         String[] @default([])
  yes_label          String
  no_label           String
  top_probability    Float    @db.Real
  odds_yes           Int
  odds_no            Int
  outcomes           Json
  volume             Float    @default(0) @db.Real
  volume_24h         Float    @default(0) @db.Real
  liquidity          Float    @default(0) @db.Real
  predscope_url      String   @default("")
  synced_at          DateTime @default(now()) @db.Timestamp(6)
  on_chain_market_id Int?
}
